␀␀␀␀␀␀␀␀␀␀$-	8EUc%k*r>’æg¸ˆÇ˘¯{ˇˇˇˇÜˇˇáÙ”iëZçC1å:BÖ7<ÖA4Ωâ\ˇÁñˇÙ{ƒ∞Fj;l11f-/`+ÚƒsæëCP > /"	␀	␀␀"+

