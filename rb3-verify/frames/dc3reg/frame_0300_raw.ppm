␀␀	#"4CZ!ÃÉN˙´^ˇ∫]ˇºZ˝∏[ˇ∑eŸâIz.`#&Z%=N2[-ïTCÈ†sÛ°Z¿s7]#C$=#S%∆ãQõc*2	␀␀␀␀␀␀␀␀␀␀␀␀␀
