␀␀␀␀␀␀␀␀␀␀	",8FWfq$"s7‹¡m˜|ˇ¸|˝¸yˇˇÅˇıÅÏ√cëQá61Ö,AÉ-@t''¡ÉbˇÿìˇÍ~≈§Gr6j$0a!.b(ˆ¿y∑Ü@A7%$	␀␀␀␀␀␀␀	␀"	+
