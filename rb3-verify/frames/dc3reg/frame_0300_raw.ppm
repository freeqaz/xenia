 	%$5?\%ºxCÚ•Z˘™Rˇ±U¯ØWˆ™_⁄ÉLÖ3c&#U!.S*TõUF‰ñmÒõRºl,]G#B&OÀâZû`3<␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀
