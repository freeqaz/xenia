␀␀&	)!)!+%(#	␀␀␀␀␀ #  ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!␀␀␀␀␀␀	
